# Copy to .env and fill in. nekora loads it on start; .env is gitignored.
# Keys are read from the environment, never baked into the code.

# Telegram user ID of Nekora's developer. Only this person can discuss her
# implementation, models, or development wishes; leave blank to disable.
NEKORA_CREATOR_USER_ID=

# Visible conversation runs on DeepSeek. Private maintenance and primary vision
# use the direct Mistral API; vision falls back to OpenRouter and then local
# Ollama. Embeddings stay local. With NEKORA_MANAGE_OLLAMA=1 the binary starts
# Ollama and pulls bge-m3 + the local fallback model.
# DeepSeek -- main brain (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
# Mistral -- diary maintenance and primary vision (https://console.mistral.ai)
MISTRAL_API_KEY=
# MISTRAL_API_BASE=https://api.mistral.ai/v1
# OpenRouter -- vision fallback and optional web search.
OPENROUTER_API_KEY=
# Optional OpenAI-compatible endpoint override; defaults to DeepSeek.
# NEKORA_MAIN_API_BASE=https://api.deepseek.com/v1
# Which brain to run (must do tool calls). Default deepseek-v4-flash.
# NEKORA_MAIN_MODEL=deepseek-v4-flash
# OpenRouter vision fallback; Mistral is tried first when MISTRAL_API_KEY is set.
NEKORA_VISION_MODEL=qwen/qwen3-vl-32b-instruct
NEKORA_LOCAL_VISION_MODEL=qwen2.5vl:3b
# Private diary, working-memory maintenance, and reflection through Mistral.
NEKORA_REASONING_MODEL=mistral-small-2603
NEKORA_MISTRAL_VISION_MODEL=mistral-small-2603
# NEKORA_VISION_API_TIMEOUT=30
# NEKORA_REQUEST_TIMEOUT=120      # raise if vision cold-loads slowly on local CPU

# Image generation is opt-in because it can spend provider credits. The prompt
# engineer returns only the scene-specific replacement for {SCENE_REQUEST}; the
# built-in canonical Nekora image prompt supplies identity, style, and negatives.
# NEKORA_IMAGE_MODEL=qwen/qwen-image-3
# NEKORA_IMAGE_PROMPT_MODEL=deepseek/deepseek-v4-flash
# NEKORA_IMAGE_REFERENCES=references/nekora-reference-sheet.png,references/nekora-reference-portrait.png
# If NEKORA_IMAGE_REFERENCES is unset, image files in references/ are used.
# NEKORA_IMAGE_PROMPT=      # optional full template override
# NEKORA_IMAGE_TIMEOUT=300  # image generation may take several minutes

# Cloud web search. Providers are tried left to right; temporary failures and
# rate limits move to the next provider. No local search service is required.
NEKORA_WEB_SEARCH_CHAIN=ollama,openrouter
OLLAMA_API_KEY=
# OLLAMA_WEB_SEARCH_URL=https://ollama.com/api/web_search
# OPENROUTER_API_KEY above is reused by this provider.
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_WEB_SEARCH_MODEL=openai/gpt-4.1-mini
# OPENROUTER_WEB_SEARCH_ENGINE=auto
# NEKORA_WEB_SEARCH_TIMEOUT=30
# NEKORA_WEB_SEARCH_COOLDOWN=300

# Telegram userbot -- api_id/api_hash from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional: the account phone, in international format. If unset, nekora prompts
# for it (and the login code, and any 2FA password) on the first run only.
# TELEGRAM_PHONE=

# Who Nekora is, and whose account this is (papik = the instance owner).
NEKORA_NAME=Nekora
PAPIK_NAME=

# Optional: local Ollama host, Telegram session name, vault path.
# OLLAMA_HOST=http://127.0.0.1:11434   # 127.0.0.1 (not localhost) avoids an IPv6 ::1 connect-hang
# Docker sets NEKORA_MANAGE_OLLAMA=1 and starts this host itself. Set the flag
# locally only when this process should own an Ollama server too.
# NEKORA_MANAGE_OLLAMA=1
# NEKORA_OLLAMA_START_TIMEOUT=120
# To use an external server instead, leave NEKORA_MANAGE_OLLAMA unset. In Docker,
# `localhost` is the container: set OLLAMA_HOST=http://host.docker.internal:11434
# and add `--add-host=host.docker.internal:host-gateway` if needed.
# NEKORA_SESSION=nekora
# NEKORA_VAULT=vault

# Optional OpenAI-compatible HTTP endpoint. It is disabled when the address is
# empty. Keep it on loopback unless a long random bearer token is configured.
# NEKORA_PROXY_ADDR=127.0.0.1:10434
# NEKORA_PROXY_TOKEN=
# Set to 1 to run only the proxy without Telegram login. Telegram tools are
# unavailable in this mode; persona and diary context remain available.
# NEKORA_PROXY_ONLY=1
