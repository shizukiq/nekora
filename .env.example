# Copy to .env and fill in. nekora loads it on start; .env is gitignored.
# Keys are read from the environment, never baked into the code.

# Controls the focus and sleep quality (float from 0.0 to 3.7)
DICK_INCHES_DEEP=

# How often femboy pics are sent mid-conversation (float from 0.0 to 1.0)
FEMBOY_RATIO=

# The brain runs on DeepSeek. Vision and embeddings stay LOCAL: with
# NEKORA_MANAGE_OLLAMA=1 the binary starts Ollama and pulls bge-m3 + qwen2.5vl.
# DeepSeek -- main brain (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
# Optional OpenAI-compatible endpoint override; defaults to DeepSeek.
# NEKORA_MAIN_API_BASE=https://api.deepseek.com/v1/
# Which brain to run (must do tool calls). Default deepseek-v4-flash.
# NEKORA_MAIN_MODEL=deepseek-v4-flash
# NEKORA_VISION_MODEL=qwen2.5vl:3b
# NEKORA_REQUEST_TIMEOUT=120      # raise if vision cold-loads slowly on local CPU

# Telegram userbot -- api_id/api_hash from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional: the account phone, in international format. If unset, nekora prompts
# for it (and the login code, and any 2FA password) on the first run only.
# TELEGRAM_PHONE=

# Who Nekora is, and whose account this is (papik = the instance owner).
# PAPIK_CHAT_ID gets priority and can wake her; find it via @getmyid_bot.
NEKORA_NAME=Nekora
PAPIK_NAME=
PAPIK_CHAT_ID=0

# Optional: local Ollama host, Telegram session name, vault path.
# OLLAMA_HOST=http://127.0.0.1:11434   # 127.0.0.1 (not localhost) avoids an IPv6 ::1 connect-hang
# Docker sets NEKORA_MANAGE_OLLAMA=1 and starts this host itself. Set the flag
# locally only when this process should own an Ollama server too.
# NEKORA_MANAGE_OLLAMA=1
# NEKORA_OLLAMA_START_TIMEOUT=120
# To use an external server instead, leave NEKORA_MANAGE_OLLAMA unset. In Docker,
# `localhost` is the container: set OLLAMA_HOST=http://host.docker.internal:11434
# and add `--add-host=host.docker.internal:host-gateway` if needed.
# NEKORA_SESSION=nekora
# NEKORA_VAULT=vault
